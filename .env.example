# Local-only host port when using docker-compose.local.yml.
APP_PORT=3000

# PostgreSQL container settings.
POSTGRES_DB=control_bobinas
POSTGRES_USER=control_bobinas
POSTGRES_PASSWORD=change-this-to-a-long-random-password

# Keep this name stable in Dokploy so redeployments keep the same database volume.
POSTGRES_VOLUME_NAME=control-almacen_postgres_data

# Use the same values above. If the password contains reserved URL characters,
# URL-encode it before putting it in this connection string.
DATABASE_URL=postgresql://control_bobinas:change-this-to-a-long-random-password@db:5432/control_bobinas

# Optional comma-separated browser origins for external API clients.
# Leave empty for the same-domain web application.
CORS_ORIGIN=

# Optional JSON-log level. Keep info in production unless debugging is needed.
LOG_LEVEL=info

# Service-to-service integration token for GestionPedidosPigmea (NEXUS)
GESTION_PEDIDOS_INTEGRATION_TOKEN=
